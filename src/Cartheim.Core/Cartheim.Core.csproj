<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure cart rules: no Unity or Valheim references, so it survives game updates and tests run without the game. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Camps recorded in the dev world, one per building (see CampRecords). -->
    <EmbeddedResource Include="Camps\*.camp" />
  </ItemGroup>
</Project>
